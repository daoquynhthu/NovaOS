# NovaOS Build/Test Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# Build directory override (default: "build")
# NOVA_BUILD_DIR=build

# Test timing parameters
# NOVA_TEST_TIMEOUT_SECONDS=120
# NOVA_TEST_SLEEP_SCALE=1.0
# NOVA_TEST_CHAR_DELAY_MS=4
# NOVA_TEST_BULK_SEND=0

# QEMU configuration
# NOVA_QEMU_ACCEL=kvm
# NOVA_QEMU_CPU=host
# NOVA_QEMU_MACHINE=q35

# Boot trace level (0=off, 1=critical, 2=bring-up, 3=verbose)
# NOVA_BOOT_TRACE_LEVEL=0
